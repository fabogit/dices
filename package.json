{
  "name": "dices",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "author": "fabogit",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "test:e2e": "playwright test",
    "test:e2e:guard": "node scripts/check-e2e-selectors.mjs",
    "lint": "vp lint",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check": "pnpm run check:types && pnpm run check:svelte && vp check"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "^21.0.4",
    "svelte": "^5.46.4",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=11.21.0"
  },
  "packageManager": "pnpm@11.21.0"
}
