{
  "name": "dices",
  "version": "1.0.2",
  "private": true,
  "license": "MIT",
  "author": "fabogit",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:guard": "node scripts/check-e2e-selectors.mjs",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check": "pnpm run check:types && pnpm run check:svelte && pnpm run lint && pnpm run format:check"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "svelte": "^5.15.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=11.21.0"
  },
  "packageManager": "pnpm@11.21.0"
}
