{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    ".svelte-check/**"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "eslint/no-underscore-dangle": "off",
    "typescript/require-array-sort-compare": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.{test,spec}.{js,ts}"],
      "plugins": ["vitest"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/ui/primitives/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*rollState*"],
                "message": "Presentational primitives must not import rollState; pass typed props and callbacks instead."
              }
            ]
          }
        ]
      }
    }
  ]
}
